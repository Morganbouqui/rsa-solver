#!/usr/bin/env python3
"""RSA Solver - educational RSA/CTF helper.

Solves deliberately weak RSA exercises from n/e/c or known p/q/e/c.
It does not claim to factor properly generated modern RSA keys.
"""
from __future__ import annotations

import argparse
import math
import multiprocessing as mp
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from typing import Optional


@dataclass
class FactorResult:
    p: int
    q: int
    method: str


def parse_int(value: str) -> int:
    value = value.strip().replace("_", "")
    if not value:
        raise ValueError("empty integer")
    # Decimal by default; explicit 0x/0o/0b are accepted.
    base = 0 if value.lower().startswith(("0x", "0o", "0b")) else 10
    number = int(value, base)
    if number < 0:
        raise ValueError("RSA values must be non-negative")
    return number


def int_to_bytes(value: int, length: Optional[int] = None) -> bytes:
    if value < 0:
        raise ValueError("cannot encode a negative integer")
    if length is None:
        length = max(1, (value.bit_length() + 7) // 8)
    return value.to_bytes(length, "big")


def printable_text(data: bytes) -> Optional[str]:
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if all(ch.isprintable() or ch in "\r\n\t" for ch in text):
        return text
    return None


def strip_pkcs1_v15_encryption(block: bytes) -> Optional[bytes]:
    # RSAES-PKCS1-v1_5 encoded message: 00 02 PS 00 M, PS >= 8 non-zero bytes.
    if len(block) < 11 or not block.startswith(b"\x00\x02"):
        return None
    sep = block.find(b"\x00", 2)
    if sep < 10:
        return None
    if any(b == 0 for b in block[2:sep]):
        return None
    return block[sep + 1 :]


def decrypt_with_factors(p: int, q: int, e: int, c: int) -> dict:
    for name, value in (("p", p), ("q", q), ("e", e)):
        if value <= 1:
            raise ValueError(f"{name} must be greater than 1")
    n = p * q
    if not (0 <= c < n):
        raise ValueError("ciphertext c must satisfy 0 <= c < n")

    # Correct Euler phi for p == q as well as ordinary p != q RSA.
    phi = p * (p - 1) if p == q else (p - 1) * (q - 1)
    if math.gcd(e, phi) != 1:
        raise ValueError("e has no modular inverse modulo phi(n)")
    d = pow(e, -1, phi)
    m = pow(c, d, n)

    raw_minimal = int_to_bytes(m)
    modulus_len = max(1, (n.bit_length() + 7) // 8)
    raw_block = int_to_bytes(m, modulus_len)
    unpadded = strip_pkcs1_v15_encryption(raw_block)

    return {
        "n": n,
        "phi": phi,
        "d": d,
        "m": m,
        "raw": raw_minimal,
        "block": raw_block,
        "unpadded": unpadded,
    }


def _small_prime_factor(n: int, limit: int = 100_000) -> Optional[int]:
    if n % 2 == 0:
        return 2
    d = 3
    while d <= limit and d * d <= n:
        if n % d == 0:
            return d
        d += 2
    return None


def fermat_factor(n: int, max_steps: int = 250_000) -> Optional[FactorResult]:
    if n % 2 == 0:
        return FactorResult(2, n // 2, "even modulus")
    a = math.isqrt(n)
    if a * a < n:
        a += 1
    for _ in range(max_steps):
        b2 = a * a - n
        b = math.isqrt(b2)
        if b * b == b2:
            p, q = a - b, a + b
            if p > 1 and p * q == n:
                return FactorResult(min(p, q), max(p, q), "Fermat")
        a += 1
    return None


def pollard_rho(n: int, attempts: int = 12, iterations: int = 150_000) -> Optional[int]:
    if n % 2 == 0:
        return 2
    if n % 3 == 0:
        return 3
    for attempt in range(attempts):
        # Deterministic-ish constants make tests repeatable; x varies per attempt.
        c = 1 + 2 * attempt
        x = 2 + attempt
        y = x
        d = 1
        for _ in range(iterations):
            x = (x * x + c) % n
            y = (y * y + c) % n
            y = (y * y + c) % n
            d = math.gcd(abs(x - y), n)
            if d == 1:
                continue
            if d != n:
                return d
            break
    return None


def _sympy_worker(n: int, queue: mp.Queue) -> None:
    try:
        from sympy import factorint  # optional dependency
        factors = factorint(n)
        expanded = []
        for prime, exponent in factors.items():
            expanded.extend([int(prime)] * int(exponent))
        queue.put(("ok", expanded))
    except Exception as exc:
        queue.put(("error", str(exc)))


def sympy_factor_with_timeout(n: int, timeout: float) -> Optional[FactorResult]:
    if timeout <= 0:
        return None
    queue: mp.Queue = mp.Queue()
    proc = mp.Process(target=_sympy_worker, args=(n, queue), daemon=True)
    proc.start()
    proc.join(timeout)
    if proc.is_alive():
        proc.terminate()
        proc.join()
        return None
    if queue.empty():
        return None
    status, payload = queue.get()
    if status != "ok" or len(payload) != 2:
        return None
    p, q = payload
    if p * q != n:
        return None
    return FactorResult(min(p, q), max(p, q), "SymPy factorint")



def parse_external_factors(text: str, n: int) -> Optional[FactorResult]:
    """Parse candidate factors from YAFU/msieve output and verify them against n."""
    candidates = set()
    patterns = (
        r"(?im)^\s*(?:p|prp)\d+\s*[=:]\s*(\d+)\s*$",
        r"(?im)^\s*factor:\s*(\d+)\s*$",
    )
    for pattern in patterns:
        for value in re.findall(pattern, text):
            candidates.add(int(value))
    for p in sorted(candidates):
        if 1 < p < n and n % p == 0:
            q = n // p
            return FactorResult(min(p, q), max(p, q), "external factorer")
    return None


def external_factor(n: int, timeout: float = 300.0, backend: str = "auto") -> Optional[FactorResult]:
    """Run an installed YAFU or msieve backend with a hard timeout."""
    if timeout <= 0:
        return None
    choices = []
    if backend in ("auto", "yafu") and shutil.which("yafu"):
        choices.append(("YAFU", ["yafu", f"factor({n})", "-silent"]))
    if backend in ("auto", "msieve") and shutil.which("msieve"):
        choices.append(("msieve", ["msieve", "-q", str(n)]))
    if backend not in ("auto", "yafu", "msieve"):
        raise ValueError("factor backend must be auto, yafu, or msieve")
    if not choices:
        return None

    for name, command in choices:
        try:
            proc = subprocess.run(
                command, check=False, capture_output=True, text=True,
                timeout=timeout, shell=False,
            )
        except subprocess.TimeoutExpired:
            continue
        result = parse_external_factors(proc.stdout + "\n" + proc.stderr, n)
        if result:
            result.method = name
            return result
    return None


def factor_weak_modulus(
    n: int,
    fermat_steps: int = 250_000,
    rho_attempts: int = 12,
    rho_iterations: int = 150_000,
    sympy_timeout: float = 20.0,
) -> Optional[FactorResult]:
    if n <= 3:
        return None
    f = _small_prime_factor(n)
    if f:
        return FactorResult(min(f, n // f), max(f, n // f), "small-prime trial division")

    result = fermat_factor(n, fermat_steps)
    if result:
        return result

    f = pollard_rho(n, rho_attempts, rho_iterations)
    if f and 1 < f < n:
        return FactorResult(min(f, n // f), max(f, n // f), "Pollard rho")

    return sympy_factor_with_timeout(n, sympy_timeout)




def integer_nth_root(value: int, degree: int) -> tuple[int, bool]:
    """Return floor(value ** (1/degree)) and whether the root is exact."""
    if value < 0 or degree <= 0:
        raise ValueError("value must be non-negative and degree positive")
    if value in (0, 1) or degree == 1:
        return value, True
    low, high = 0, 1 << ((value.bit_length() + degree - 1) // degree)
    while low + 1 < high:
        mid = (low + high) // 2
        power = pow(mid, degree)
        if power == value:
            return mid, True
        if power < value:
            low = mid
        else:
            high = mid
    return low, pow(low, degree) == value


def crt(congruences: list[tuple[int, int]]) -> tuple[int, int]:
    """Chinese Remainder Theorem for pairwise-coprime moduli."""
    if not congruences:
        raise ValueError("provide at least one congruence")
    modulus = 1
    for _, n in congruences:
        if n <= 1:
            raise ValueError("CRT moduli must be greater than 1")
        if math.gcd(modulus, n) != 1:
            raise ValueError("CRT moduli must be pairwise coprime")
        modulus *= n
    total = 0
    for residue, n in congruences:
        part = modulus // n
        total = (total + (residue % n) * part * pow(part, -1, n)) % modulus
    return total, modulus


def hastad_broadcast_attack(samples: list[tuple[int, int]], e: int) -> Optional[int]:
    """Recover an unpadded message sent under the same small e to coprime moduli."""
    if e <= 1:
        raise ValueError("e must be greater than 1")
    if len(samples) < e:
        return None
    combined, _ = crt([(c, n) for n, c in samples[:e]])
    root, exact = integer_nth_root(combined, e)
    return root if exact else None


def common_modulus_attack(n: int, e1: int, c1: int, e2: int, c2: int) -> Optional[int]:
    """Recover a textbook-RSA message when one modulus is reused with coprime exponents."""
    if n <= 1 or min(e1, e2) <= 1:
        raise ValueError("invalid RSA parameters")
    g = math.gcd(e1, e2)
    if g != 1:
        return None

    def egcd(a: int, b: int) -> tuple[int, int, int]:
        if b == 0:
            return a, 1, 0
        d, x1, y1 = egcd(b, a % b)
        return d, y1, x1 - (a // b) * y1

    _, a, b = egcd(e1, e2)

    def signed_pow(base: int, exponent: int) -> int:
        if exponent < 0:
            try:
                base = pow(base, -1, n)
            except ValueError:
                return -1
            exponent = -exponent
        return pow(base, exponent, n)

    left, right = signed_pow(c1, a), signed_pow(c2, b)
    if left < 0 or right < 0:
        return None
    return (left * right) % n


def low_exponent_textbook_attack(c: int, e: int) -> Optional[int]:
    """Recover m when textbook RSA has no padding and m**e is smaller than n."""
    if c < 0 or e <= 1:
        raise ValueError("invalid ciphertext/exponent")
    root, exact = integer_nth_root(c, e)
    return root if exact else None


def show_recovered_message(m: int) -> None:
    data = int_to_bytes(m)
    print(f"[+] Plaintext integer  : {m}")
    print(f"[+] Plaintext hex      : {data.hex()}")
    print(f"[+] Plaintext bytes    : {data!r}")
    decoded = printable_text(data)
    if decoded is not None:
        print(f"[+] Plaintext text     : {decoded}")


def continued_fraction(numerator: int, denominator: int):
    while denominator:
        a = numerator // denominator
        yield a
        numerator, denominator = denominator, numerator - a * denominator


def convergents(terms):
    p2, p1, q2, q1 = 0, 1, 1, 0
    for a in terms:
        p, q = a * p1 + p2, a * q1 + q2
        yield p, q
        p2, p1, q2, q1 = p1, p, q1, q


def wiener_attack(n: int, e: int) -> Optional[FactorResult]:
    """Recover p and q when RSA uses an unusually small private exponent d."""
    if n <= 0 or e <= 1:
        return None
    for k, d in convergents(continued_fraction(e, n)):
        if k == 0 or d == 0:
            continue
        value = e * d - 1
        if value % k:
            continue
        phi = value // k
        s = n - phi + 1
        disc = s * s - 4 * n
        if disc < 0:
            continue
        root = math.isqrt(disc)
        if root * root != disc or (s + root) % 2:
            continue
        p, q = (s + root) // 2, (s - root) // 2
        if p > 1 and q > 1 and p * q == n:
            return FactorResult(min(p, q), max(p, q), "Wiener small-d")
    return None


def shared_prime_gcd(moduli: list[int]) -> list[tuple[int, int, int]]:
    """Find pairs of RSA moduli that share a non-trivial prime factor."""
    findings = []
    for i in range(len(moduli)):
        for j in range(i + 1, len(moduli)):
            g = math.gcd(moduli[i], moduli[j])
            if 1 < g < moduli[i] and 1 < g < moduli[j]:
                findings.append((i, j, g))
    return findings


def parse_moduli_text(value: str) -> list[int]:
    return [parse_int(x) for x in re.split(r"[\\s,;]+", value.strip()) if x]


def rsa_findings(n: int, e: Optional[int] = None) -> list[str]:
    findings = []
    bits = n.bit_length()
    if bits < 2048:
        findings.append(f"modulus is {bits} bits; review against the assessment key-size policy")
    if n % 2 == 0:
        findings.append("modulus is even and trivially factorable")
    root = math.isqrt(n)
    if root * root == n:
        findings.append("modulus is a perfect square")
    if e is not None:
        if e <= 1 or e % 2 == 0:
            findings.append("public exponent is structurally invalid or suspicious")
        elif e == 3:
            findings.append("e=3 detected; not a break by itself, but padding/construction requires review")
        elif e not in (3, 17, 65537):
            findings.append(f"uncommon public exponent e={e}; review rather than assuming vulnerability")
    return findings


def show_assessment(n: int, e: Optional[int] = None) -> None:
    inspect_values(n, e)
    observations = rsa_findings(n, e)
    if observations:
        print("\\nAssessment observations:")
        for item in observations:
            print(f"  - {item}")
    else:
        print("\\n[*] No basic parameter red flags detected.")
    if e is not None:
        result = wiener_attack(n, e)
        if result:
            print(f"[!] CONFIRMED weak private exponent ({result.method})")
            print(f"[+] p = {result.p}")
            print(f"[+] q = {result.q}")
        else:
            print("[*] Wiener small-d test: no recovery")


def run_openssl(args: list[str]) -> str:
    if shutil.which("openssl") is None:
        raise RuntimeError("OpenSSL is required for PEM/certificate analysis")
    proc = subprocess.run(
        ["openssl", *args], check=False, capture_output=True, text=True, timeout=15
    )
    if proc.returncode != 0:
        raise ValueError(proc.stderr.strip() or "OpenSSL could not parse the input")
    return proc.stdout


def parse_openssl_rsa_public(text: str) -> tuple[int, int]:
    """Extract n/e from the human-readable output of OpenSSL RSA commands."""
    lines = text.splitlines()
    modulus_lines = []
    exponent = None
    collecting = False

    for line in lines:
        stripped = line.strip()
        if stripped == "Modulus:":
            collecting = True
            continue
        if collecting and stripped.startswith("Exponent:"):
            match = re.search(r"Exponent:\s*(\d+)", stripped)
            if match:
                exponent = int(match.group(1))
            break
        if collecting:
            if re.fullmatch(r"[0-9a-fA-F:]+", stripped):
                modulus_lines.append(stripped)
            elif stripped:
                collecting = False

    if not modulus_lines or exponent is None:
        raise ValueError("could not extract an RSA modulus/exponent from OpenSSL output")

    hex_n = "".join(modulus_lines).replace(":", "")
    # OpenSSL commonly prefixes a positive ASN.1 INTEGER with 00.
    if len(hex_n) > 2 and hex_n.startswith("00"):
        hex_n = hex_n[2:]
    return int(hex_n, 16), exponent


def analyze_key_file(path: str, certificate: bool = False) -> tuple[int, int]:
    if certificate:
        text = run_openssl(["x509", "-in", path, "-noout", "-text"])
    else:
        text = run_openssl(["pkey", "-pubin", "-in", path, "-text", "-noout"])
    return parse_openssl_rsa_public(text)


def interactive_shared_gcd() -> None:
    print("\\nPaste decimal/0x moduli separated by spaces, commas, or semicolons.")
    moduli = parse_moduli_text(input("moduli > "))
    if len(moduli) < 2:
        raise ValueError("provide at least two moduli")
    findings = shared_prime_gcd(moduli)
    if not findings:
        print("[*] No shared prime factors found.")
        return
    for i, j, g in findings:
        print(f"[!] CONFIRMED shared factor between n[{i}] and n[{j}]")
        print(f"    gcd = {g}")
        print(f"    n[{i}] other factor = {moduli[i] // g}")
        print(f"    n[{j}] other factor = {moduli[j] // g}")


def interactive_file_analysis(certificate: bool = False) -> None:
    path = input("path > ").strip()
    n, e = analyze_key_file(path, certificate)
    print(f"[+] RSA modulus n : {n}")
    print(f"[+] exponent e    : {e}")
    show_assessment(n, e)

def show_plaintext(result: dict) -> None:
    print(f"\n[+] Private exponent d : {result['d']}")
    print(f"[+] Plaintext integer  : {result['m']}")
    print(f"[+] Plaintext hex      : {result['raw'].hex()}")
    print(f"[+] Plaintext bytes    : {result['raw']!r}")

    text = printable_text(result["raw"])
    if text is not None:
        print(f"[+] Plaintext text     : {text}")
    else:
        print("[*] Minimal plaintext bytes are not clean UTF-8 text.")

    if result["unpadded"] is not None:
        data = result["unpadded"]
        print("[+] PKCS#1 v1.5 block  : detected")
        print(f"[+] Unpadded bytes     : {data!r}")
        decoded = printable_text(data)
        if decoded is not None:
            print(f"[+] Unpadded text      : {decoded}")


def solve_nec(n: int, e: int, c: int, sympy_timeout: float = 20.0,
              external_timeout: float = 0.0, factor_backend: str = "auto") -> bool:
    if n <= 3 or e <= 1:
        raise ValueError("n must be > 3 and e must be > 1")
    if not (0 <= c < n):
        raise ValueError("ciphertext c must satisfy 0 <= c < n")

    print(f"\n[*] n bits : {n.bit_length()}")
    print("[*] Trying bounded weak-key factoring methods...")
    started = time.monotonic()
    factors = factor_weak_modulus(n, sympy_timeout=sympy_timeout)
    elapsed = time.monotonic() - started

    if factors is None and external_timeout > 0:
        available = [name for name in ("yafu", "msieve") if shutil.which(name)]
        if available:
            print(f"[*] Escalating to external factorer: {', '.join(available)}")
            factors = external_factor(n, external_timeout, factor_backend)
        else:
            print("[*] External factoring requested, but YAFU/msieve is not installed.")

    if factors is None:
        print(f"[!] No factors found within the configured bounds ({elapsed:.1f}s).")
        print("[*] This does NOT mean n is unfactorable.")
        print("[*] Install YAFU/msieve and use --external-timeout, or supply known p/q.")
        return False

    print(f"[+] Factored with      : {factors.method}")
    print(f"[+] p                  : {factors.p}")
    print(f"[+] q                  : {factors.q}")
    print(f"[+] Verified p * q == n: {factors.p * factors.q == n}")
    result = decrypt_with_factors(factors.p, factors.q, e, c)
    show_plaintext(result)
    return True


def inspect_values(n: int, e: Optional[int] = None, c: Optional[int] = None) -> None:
    print("\n=== RSA INSPECTION ===")
    print(f"n      : {n}")
    print(f"n bits : {n.bit_length()}")
    print(f"n odd  : {bool(n & 1)}")
    if e is not None:
        print(f"e      : {e}")
        print(f"e common value : {e in (3, 17, 65537)}")
    if c is not None:
        print(f"c      : {c}")
        print(f"c < n  : {c < n}")
    root = math.isqrt(n)
    print(f"is square : {root * root == n}")


def read_integer(name: str, default: Optional[int] = None) -> int:
    while True:
        suffix = f" [{default}]" if default is not None else ""
        raw = input(f"{name}{suffix} > ").strip()
        if not raw and default is not None:
            return default
        try:
            return parse_int(raw)
        except ValueError as exc:
            print(f"[!] Invalid {name}: {exc}")


