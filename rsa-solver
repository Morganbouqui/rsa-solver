                moduli = parse_moduli_text(input("moduli > "))
                if not moduli:
                    raise ValueError("provide at least one modulus")
                for idx, modulus in enumerate(moduli):
                    print(f"\\n--- n[{idx}] ---")
                    show_assessment(modulus)
                for i, j, g in shared_prime_gcd(moduli):
                    print(f"[!] CONFIRMED shared factor n[{i}] / n[{j}]: {g}")
                input("\\nPress Enter to return...")
            elif choice == "10":
                print("\n=== COMMON MODULUS ATTACK ===\n")
                n = read_integer("n")
                e1 = read_integer("e1")
                c1 = read_integer("c1")
                e2 = read_integer("e2")
                c2 = read_integer("c2")
                m = common_modulus_attack(n, e1, c1, e2, c2)
                if m is None:
                    print("[*] Conditions not met or message could not be recovered.")
                else:
                    print("[!] CONFIRMED common-modulus recovery")
                    show_recovered_message(m)
                input("\nPress Enter to return...")
            elif choice == "11":
                print("\n=== HASTAD BROADCAST ATTACK ===\n")
                e = read_integer("e", 3)
                count = read_integer("number of samples")
                samples = []
                for idx in range(count):
                    print(f"--- sample {idx + 1} ---")
                    samples.append((read_integer("n"), read_integer("c")))
                m = hastad_broadcast_attack(samples, e)
                if m is None:
                    print("[*] Conditions not met or exact plaintext root not recovered.")
                else:
                    print("[!] CONFIRMED broadcast recovery")
                    show_recovered_message(m)
                input("\nPress Enter to return...")
            elif choice == "12":
                print("\n=== TEXTBOOK LOW-EXPONENT ATTACK ===\n")
                e = read_integer("e", 3)
                c = read_integer("c")
                m = low_exponent_textbook_attack(c, e)
                if m is None:
                    print("[*] Ciphertext is not an exact e-th power.")
                else:
                    print("[!] CONFIRMED unpadded low-exponent recovery")
                    show_recovered_message(m)
                input("\nPress Enter to return...")
            elif choice == "0":
                return 0
            else:
                print("[!] Choose a menu option from 0 through 12.")
        except KeyboardInterrupt:
            print("\n[!] Cancelled. Returning to menu.")
        except (ValueError, OverflowError) as exc:
            print(f"\n[!] {exc}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rsa-solver",
        description="Educational and authorized-assessment RSA security toolkit.",
    )
    parser.add_argument("--sympy-timeout", type=float, default=20.0,
                        help="seconds allowed for optional SymPy factoring (default: 20)")
    parser.add_argument("--external-timeout", type=float, default=0.0,
                        help="seconds allowed for installed YAFU/msieve; 0 disables escalation")
    parser.add_argument("--factor-backend", choices=("auto", "yafu", "msieve"), default="auto",
                        help="external factorer preference (default: auto)")
    sub = parser.add_subparsers(dest="command")

    nec = sub.add_parser("solve", help="factor weak n and decrypt c")
    nec.add_argument("--n", required=True, type=parse_int)
    nec.add_argument("--e", default=65537, type=parse_int)
    nec.add_argument("--c", required=True, type=parse_int)

    pq = sub.add_parser("solve-pq", help="decrypt when p and q are already known")
    pq.add_argument("--p", required=True, type=parse_int)
    pq.add_argument("--q", required=True, type=parse_int)
    pq.add_argument("--e", default=65537, type=parse_int)
    pq.add_argument("--c", required=True, type=parse_int)

    ins = sub.add_parser("inspect", help="inspect RSA integer values")
    ins.add_argument("--n", required=True, type=parse_int)
    ins.add_argument("--e", type=parse_int)
    ins.add_argument("--c", type=parse_int)

    wie = sub.add_parser("wiener", help="test for an unusually small private exponent")
    wie.add_argument("--n", required=True, type=parse_int)
    wie.add_argument("--e", required=True, type=parse_int)

    gcdp = sub.add_parser("shared-gcd", help="find shared prime factors across moduli")
    gcdp.add_argument("moduli", nargs="+", type=parse_int)

    key = sub.add_parser("key", help="analyze an RSA public key PEM")
    key.add_argument("path")

    cert = sub.add_parser("cert", help="analyze an X.509 certificate RSA key")
    cert.add_argument("path")

    batch = sub.add_parser("batch", help="batch-assess moduli and test shared factors")
    batch.add_argument("moduli", nargs="+", type=parse_int)

    common = sub.add_parser("common-modulus", help="recover textbook RSA reused under one modulus")
    common.add_argument("--n", required=True, type=parse_int)
    common.add_argument("--e1", required=True, type=parse_int)
    common.add_argument("--c1", required=True, type=parse_int)
    common.add_argument("--e2", required=True, type=parse_int)
    common.add_argument("--c2", required=True, type=parse_int)

    broadcast = sub.add_parser("broadcast", help="Hastad broadcast recovery for textbook RSA")
    broadcast.add_argument("--e", default=3, type=parse_int)
    broadcast.add_argument("pairs", nargs="+", help="n:c samples")

    lowe = sub.add_parser("low-e", help="recover an exact unpadded low-exponent plaintext")
    lowe.add_argument("--e", default=3, type=parse_int)
    lowe.add_argument("--c", required=True, type=parse_int)
    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "solve":
            return 0 if solve_nec(args.n, args.e, args.c, args.sympy_timeout,
                                  args.external_timeout, args.factor_backend) else 2
        if args.command == "solve-pq":
            result = decrypt_with_factors(args.p, args.q, args.e, args.c)
            show_plaintext(result)
            return 0
        if args.command == "inspect":
            show_assessment(args.n, args.e)
            if args.c is not None:
                print(f"c      : {args.c}")
                print(f"c < n  : {args.c < args.n}")
            return 0
        if args.command == "wiener":
            result = wiener_attack(args.n, args.e)
            if result:
                print(f"[!] CONFIRMED: {result.method}")
                print(f"[+] p = {result.p}")
                print(f"[+] q = {result.q}")
                return 0
            print("[*] No Wiener-vulnerable small private exponent recovered.")
            return 2
        if args.command == "shared-gcd":
            findings = shared_prime_gcd(args.moduli)
            for i, j, g in findings:
                print(f"[!] CONFIRMED shared factor n[{i}] / n[{j}]: {g}")
            if not findings:
                print("[*] No shared prime factors found.")
            return 0 if findings else 2
        if args.command == "key":
            n, e = analyze_key_file(args.path, False)
            show_assessment(n, e)
            return 0
        if args.command == "cert":
            n, e = analyze_key_file(args.path, True)
            show_assessment(n, e)
            return 0
        if args.command == "batch":
            for idx, modulus in enumerate(args.moduli):
                print(f"\\n--- n[{idx}] ---")
                show_assessment(modulus)
            for i, j, g in shared_prime_gcd(args.moduli):
                print(f"[!] CONFIRMED shared factor n[{i}] / n[{j}]: {g}")
            return 0
        if args.command == "common-modulus":
            m = common_modulus_attack(args.n, args.e1, args.c1, args.e2, args.c2)
            if m is None:
                print("[*] Conditions not met or message could not be recovered.")
                return 2
            show_recovered_message(m)
            return 0
        if args.command == "broadcast":
            samples = []
            for pair in args.pairs:
                if ":" not in pair:
                    raise ValueError("broadcast samples must use n:c format")
                n_raw, c_raw = pair.split(":", 1)
                samples.append((parse_int(n_raw), parse_int(c_raw)))
            m = hastad_broadcast_attack(samples, args.e)
            if m is None:
                print("[*] Conditions not met or exact plaintext root not recovered.")
                return 2
            show_recovered_message(m)
            return 0
        if args.command == "low-e":
            m = low_exponent_textbook_attack(args.c, args.e)
            if m is None:
                print("[*] Ciphertext is not an exact e-th power.")
                return 2
            show_recovered_message(m)
            return 0
        return interactive()
    except KeyboardInterrupt:
        print("\n[!] Cancelled.", file=sys.stderr)
        return 130
    except (ValueError, OverflowError) as exc:
        print(f"[!] {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
