                print("\n=== INSPECT RSA VALUES ===\n")
                n = read_integer("n")
                e = read_integer("e", 65537)
                raw_c = input("c [optional] > ").strip()
                c = parse_int(raw_c) if raw_c else None
                inspect_values(n, e, c)
                input("\nPress Enter to return...")
            elif choice == "4":
                n = read_integer("n")
                e = read_integer("e", 65537)
